{
  "name": "ict-command-centre",
  "version": "2.0.1",
  "description": "St. Anne Mission Hospital — ICT Command Centre",
  "author": "St. Anne Mission Hospital ICT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Deric254/inventory-control.git"
  },
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0"
  },
  "build": {
    "appId": "ke.co.stannemission.ictcommandcentre",
    "productName": "ICT Command Centre",
    "copyright": "St. Anne Mission Hospital",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "src",
        "to": "src"
      },
      {
        "from": "assets",
        "to": "assets"
      },
      {
        "from": "python",
        "to": "python"
      }
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ICT Command Centre",
      "installerIcon": "icon.ico",
      "uninstallerIcon": "icon.ico",
      "artifactName": "ICT_CommandCentre_Setup.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "Deric254",
      "repo": "inventory-control",
      "releaseType": "draft"
    }
  }
}
